# Copy to .env.production on the VPS and fill in. docker-compose reads this
# file via env_file; it is never baked into the image.
#
# .env.production is gitignored — never commit the filled-in copy.

NODE_ENV=production

# --- MongoDB (Atlas) ---
# Whitelist the VPS's public IP in the Atlas Network Access list, or the app
# will start fine and then fail every query with a timeout.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=kdrive

# --- Single-user auth ---
# Header key for non-browser API clients (the Android TV app).
KDRIVE_DEVICE_KEY=
# Password for the browser sign-in at /login.
ADMIN_PASSWORD=

# --- Google Drive ---
# The OAuth app must be published (not left in "Testing"), or the refresh
# token expires after 7 days and every stream starts failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# --- TMDb metadata ---
TMDB_API_KEY=

# --- Streaming ---
# Containers /api/media/play-url may hand out a direct Google Drive URL for,
# letting the Android TV app fetch the bytes from Google instead of through
# this server. Comma-separated extensions; empty disables direct play and
# sends everything back through /api/media/stream.
#
# Browsers never get a direct URL whatever this says — Drive serves the files
# without CORS headers and a <video> element refuses them.
#
# Unset defaults to mp4,m4v,mov,webm. Matroska is left out of that default
# because Drive reports these files as application/octet-stream and ExoPlayer
# has only the bytes to identify the container with; the app states the real
# type from this server's answer, so adding mkv is expected to work — test one
# title before relying on it.
# PLAY_URL_DIRECT_CONTAINERS=mp4,m4v,mov,webm,mkv

# Truncates each /api/media/stream response to this many bytes so no single
# request approaches a serverless function's time limit. Leave unset on a VPS.
# Set to 8388608 on Vercel — but note the Android TV client (ExoPlayer) expects
# an open-ended range to run to the end of the file and may stop early when
# this is set. Browsers are unaffected.
# STREAM_MAX_CHUNK_BYTES=
