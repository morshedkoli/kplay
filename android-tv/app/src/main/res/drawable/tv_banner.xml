    android:viewportHeight="180">
    <path
        android:fillColor="#E0464A"
        android:pathData="M0,0 L320,0 L320,180 L0,180 Z" />
    <!-- stem of the k, round-capped -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M133.4,67.2 A5.7,5.7 0 0 1 144.8,67.2 L144.8,112.8 A5.7,5.7 0 0 1 133.4,112.8 Z" />
    <!-- arm, leg and play glyph, all one shape -->
